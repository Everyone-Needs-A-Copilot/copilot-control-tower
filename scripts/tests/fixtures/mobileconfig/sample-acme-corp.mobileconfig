<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copilot Control Tower — generated .mobileconfig for Acme Corp (M5/S4, `.copilot/wp/30.md`). Domain: com.everyoneneedsacopilot.controltower — must equal `managed::forced`'s reader domain (FF-M5-6). Carries ONLY references/endpoints/flags, never a secret (invariant #6, FF-M5-7). -->
<plist version="1.0">
<dict>
  <key>PayloadDescription</key>
  <string>Copilot Control Tower managed configuration for Acme Corp.</string>
  <key>PayloadDisplayName</key>
  <string>Acme Corp — Copilot Control Tower</string>
  <key>PayloadIdentifier</key>
  <string>com.acmecorp.controltower-profile</string>
  <key>PayloadOrganization</key>
  <string>Acme Corp</string>
  <key>PayloadRemovalDisallowed</key>
  <true/>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>a1b2c3d4-0000-4000-8000-000000000001</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadContent</key>
      <dict>
        <key>com.everyoneneedsacopilot.controltower</key>
        <dict>
          <key>Forced</key>
          <array>
            <dict>
              <key>mcx_preference_settings</key>
              <dict>
              <key>OrgSlug</key>
              <string>acme-corp</string>
              <key>Department</key>
              <string>engineering</string>
              <key>EcosystemSeedURL</key>
              <string>https://ecosystem.acme-corp.example/ecosystem.yml</string>
              <key>GitHubHost</key>
              <string>github.acme-corp.example</string>
              <key>AuthMode</key>
              <string>ssh-work</string>
              <key>Host</key>
              <string>managed-fleet</string>
              <key>FoundationMirror</key>
              <string>https://mirror.acme-corp.example/foundation</string>
              <key>UpdateFeedURL</key>
              <string>https://updates.acme-corp.example/latest.json</string>
              <key>UpdateChannel</key>
              <string>stable</string>
              <key>AllowSelfUpdate</key>
              <true/>
              <key>DisableWizard</key>
              <true/>
              <key>Deprovisioned</key>
              <false/>
              <key>AdminContact</key>
              <string>it-help@acme-corp.example</string>
              <key>SharedSecretStoreURL</key>
              <string>https://secrets.acme-corp.example/controltower</string>
              <key>SharedSecretStoreTier</key>
              <string>org</string>
              <key>LoginItemManaged</key>
              <true/>
              </dict>
            </dict>
          </array>
        </dict>
      </dict>
      <key>PayloadDescription</key>
      <string>Forces com.everyoneneedsacopilot.controltower&apos;s managed/security preferences for Acme Corp (invariant #4 — honored only from this forced domain).</string>
      <key>PayloadDisplayName</key>
      <string>Acme Corp — Copilot Control Tower Managed Preferences</string>
      <key>PayloadIdentifier</key>
      <string>com.acmecorp.controltower-profile.preferences</string>
      <key>PayloadOrganization</key>
      <string>Acme Corp</string>
      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <key>PayloadUUID</key>
      <string>a1b2c3d4-0000-4000-8000-000000000002</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadEnabled</key>
      <true/>
    </dict>
    <dict>
      <key>PayloadDescription</key>
      <string>Force-approves Copilot Control Tower as a non-toggleable managed login item (ADR-M5-004, fixes B-H3) — distinct from the app&apos;s own crash-only launchd watchdog.</string>
      <key>PayloadDisplayName</key>
      <string>Acme Corp — Copilot Control Tower Managed Login Item</string>
      <key>PayloadIdentifier</key>
      <string>com.acmecorp.controltower-profile.loginitem</string>
      <key>PayloadOrganization</key>
      <string>Acme Corp</string>
      <key>PayloadType</key>
      <string>com.apple.servicemanagement</string>
      <key>PayloadUUID</key>
      <string>a1b2c3d4-0000-4000-8000-000000000003</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadEnabled</key>
      <true/>
      <key>Rules</key>
      <array>
        <dict>
          <key>RuleType</key>
          <string>BundleIdentifier</string>
          <key>RuleValue</key>
          <string>com.everyoneneedsacopilot.controltower</string>
          <key>Comment</key>
          <string>One signed binary, launch-at-login only (ADR-M5-004) — never the crash-only watchdog.</string>
        </dict>
      </array>
    </dict>
    <dict>
      <key>PayloadDescription</key>
      <string>Pre-authorizes Copilot Control Tower&apos;s notifications so the safety-escalation channel (architecture.md §9) is never silently defeated by a denied permission.</string>
      <key>PayloadDisplayName</key>
      <string>Acme Corp — Copilot Control Tower Managed Notifications</string>
      <key>PayloadIdentifier</key>
      <string>com.acmecorp.controltower-profile.notifications</string>
      <key>PayloadOrganization</key>
      <string>Acme Corp</string>
      <key>PayloadType</key>
      <string>com.apple.notificationsettings</string>
      <key>PayloadUUID</key>
      <string>a1b2c3d4-0000-4000-8000-000000000004</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadEnabled</key>
      <true/>
      <key>NotificationSettings</key>
      <array>
        <dict>
          <key>BundleIdentifier</key>
          <string>com.everyoneneedsacopilot.controltower</string>
          <key>NotificationsEnabled</key>
          <true/>
          <key>ShowInNotificationCenter</key>
          <true/>
          <key>ShowInLockScreen</key>
          <true/>
          <key>AlertType</key>
          <integer>2</integer>
        </dict>
      </array>
    </dict>
  </array>
</dict>
</plist>
