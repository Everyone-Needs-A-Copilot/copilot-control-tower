<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    LSUIElement: menu-bar-only, no Dock icon, no Cmd-Tab entry — set at the
    bundle level so there is no launch-time Dock-icon flash before
    `app.set_activation_policy(Accessory)` runs in src-tauri/src/lib.rs.
    Tauri merges this file with its generated Info.plist because it lives
    next to tauri.conf.json (see MacConfig.infoPlist in the config schema).
  -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
