{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot Control Tower",
  "version": "0.1.0",
  "identifier": "com.everyoneneedsacopilot.controltower",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "title": "Copilot Control Tower",
        "width": 360,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Copilot Control Tower — Settings",
        "url": "settings.html",
        "width": 480,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      },
      {
        "label": "wizard",
        "title": "Copilot Control Tower — Setup",
        "url": "wizard.html",
        "width": 560,
        "height": 680,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
