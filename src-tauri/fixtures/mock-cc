#!/usr/bin/env bash
# mock-cc — a stand-in for the real `cc`/`copilot` CLI, driven entirely by the fixture
# corpus in this directory. Lets Control Tower be driven through every doctor state
# (and, as of M3, the wizard's device-flow sign-in seam; as of M5/S2, the deprovision
# seam) without a real fleet, a real CLI, real OAuth, or a real (mutating!) wipe. See
# README.md for the doctor corpus map, fixtures/wizard/README.md for the auth seam +
# wizard scenario corpus, and fixtures/deprovision/README.md for the deprovision corpus.
#
# Usage (mirrors the real CLI's invocation shape):
#   mock-cc doctor --json
#   mock-cc auth --json              # initiate: emit the device-flow ceremony
#   mock-cc auth --json --poll       # poll: emit the terminal (or pending) status
#   mock-cc auth login --json        # alias verb form (D-3-M3 reconciliation: the
#                                     #   wizard's host/GitHub sign-in step is one more
#                                     #   `cc auth` integration, never a `gh auth status`
#                                     #   screen-scrape) — identical behavior to `auth`.
#   mock-cc auth login --json --poll
#   mock-cc auth status --json       # WS-A Stream-Z: offline-safe "who is signed in".
#   mock-cc deprovision <org> --json # M5/S2: emit a canned deprovision REPORT — this
#                                     #   stub NEVER touches the filesystem; it only
#                                     #   prints a fixture body, exactly like `doctor`.
#   mock-cc update --json            # M6/S1: emit a canned `update --json` RESULT — this
#                                     #   stub NEVER runs a real (mutating) reconciling
#                                     #   sync; it only prints a fixture body, exactly
#                                     #   like `doctor`/`deprovision`.
#   mock-cc update --project <path> --json   # WS-A Stream-Z (Component Sync): a single
#                                     #   embedding project's materialize result — reuses
#                                     #   the SAME update/ corpus, stamped with the given
#                                     #   `--project` path (additive `path` field).
#   mock-cc update --fanout --json   # WS-A Stream-Z: the machine-wide fan-out roll-up —
#                                     #   reads projects/corpus/ (fanout_report shape).
#   mock-cc freshness --json                 # WS-A Stream-Z: cheap single-SHA poll (canned).
#   mock-cc freshness --all-projects --json  # WS-A Stream-Z: per-project sweep — reads
#                                     #   projects/corpus/ (all_projects_freshness shape).
#   mock-cc layers --json            # WS-A Stream-Z: entitlement discovery — reads
#                                     #   layers/corpus/ (list_report shape).
#   mock-cc layers join <id> --json  # WS-A Stream-Z: join action — canned join_result,
#                                     #   outcome selected by the SAME fixture name as
#                                     #   `layers --json` (available|joined|not-entitled|
#                                     #   offline map to joined|already-joined|
#                                     #   not-entitled|offline respectively).
#   mock-cc onboard --org <o> --products <p> --json
#                                     # the aggregate ecosystem PLAN call (`WizardModel.
#                                     #   performDetect`/`WizardSelftest`'s CT_SELFTEST_STEP=
#                                     #   holding). `$CT_FIXTURE`/`$CC_FIXTURE`/`--fixture`
#                                     #   is otherwise IGNORED by this verb (a fixed canned
#                                     #   body is always returned), EXCEPT the named
#                                     #   fixtures carved out for `control-tower-copy-deck.md`
#                                     #   §2.9/§2.2.1 coverage: blocked-device-ssh-held (H4,
#                                     #   invariant #3 working — a genuinely-held case, e.g.
#                                     #   a different GitHub login on the existing
#                                     #   connection; every other held cause, wrong host, no
#                                     #   repo access, malformed config, maps through the
#                                     #   SAME `config == "held"` classifier and is the
#                                     #   CLI's own tested surface, not re-fixtured here),
#                                     #   blocked-device-ssh-fault (H3, the default fault
#                                     #   variant), device-ssh-adoptable (the State 1 offer —
#                                     #   `config: "adoptable"`, a `scope: "machine"`
#                                     #   inventory row, `result: "changes-required"`, never
#                                     #   `"blocked"` — the dead end this whole change
#                                     #   replaces), device-ssh-not-permitted (H7 —
#                                     #   `registration: "not-permitted"`), exit2-onboard-unavailable
#                                     #   (H6 via a REAL, differentiated exit-2 error
#                                     #   envelope, unlike every other exit-2 fixture in
#                                     #   this script, which prints an empty body),
#                                     #   exit2-empty-fields (§2.9.1's empty-value guard: a
#                                     #   real exit-2 envelope whose code/message are
#                                     #   present but `""`, not omitted), exit2-no-company-app
#                                     #   (the real-world trigger's own code, verbatim: H6
#                                     #   for a genuine end user, or H7 self-serve when
#                                     #   THIS Mac's own admin standup brief is present —
#                                     #   `native/models.swift`'s `LocalAdminSignal`, never
#                                     #   this fixture body, is what tells the two apart).
#
# Fixture selection for `doctor` (checked in this order):
#   1. --fixture=<name> or --fixture <name> on the command line
#   2. $CT_FIXTURE           (the name documented in the M1 architecture WP — this is
#                              what src-tauri/cli/path.rs's dev override is expected to set
#                              alongside CT_CLI_PATH=/path/to/mock-cc)
#   3. $CC_FIXTURE           (alias, same meaning, for callers that prefer the CLI's own
#                              env-var naming convention)
#   4. "healthy-clean-fleet" (default, so an unconfigured run is still deterministic)
#
# <name> resolves to corpus/<name>.json first, then invalid/<name>.json, then is tried
# as a literal path. Two special names bypass the corpus entirely:
#   CT_FIXTURE=list      -> print the names of every available fixture and exit 0
#                            (no doctor/--json args required)
#   CT_FIXTURE=exit-2    -> simulate the contract's env-error path: nothing usable on
#                            stdout, a diagnostic on stderr, exit 2. This is how T3/T9
#                            exercise "do NOT trust the body" independent of any fixture
#                            file's content.
#
# Exit code for `doctor` (contractually correct per cli-contract.md's doctor row):
#   0  when the emitted JSON parses and no checker has severity:"fail"
#   1  when the emitted JSON parses and at least one checker has severity:"fail"
#   2  for CT_FIXTURE=exit-2, or if the requested fixture can't be found
#
# NOTE on the invalid/ corpus: every fixture in invalid/ *except* CT_FIXTURE=exit-2 is
# deliberately emitted with a "successful-looking" exit code (0 or 1, computed the same
# way as any other fixture) even though its body is poisoned (missing required field,
# unparseable JSON, or an out-of-range schema_version). This is intentional: it is the
# harder, more honest adversarial case — the app must fail closed on the BODY, not rely
# on the exit code to save it. Only CT_FIXTURE=exit-2 exercises the "trust nothing,
# exit code 2" path.
#
# --- auth (device-flow sign-in seam, M3, D-3-M3 mock-first) ---------------------------
# Scenario selection for `auth` (checked in this order):
#   1. --scenario=<name> or --scenario <name> on the command line
#   2. $CT_AUTH_SCENARIO     (mirrors the $CT_FIXTURE convention)
#   3. $CC_AUTH_SCENARIO     (alias, mirrors $CC_FIXTURE)
#   4. "authorized"          (default happy path, so an unconfigured run is deterministic)
#
# Scenarios: authorized | denied | expired | timeout | pending | exit-2 |
#            authorized-leaked-field-adversarial
#
# The INITIATE call (no --poll) always emits the same canned ceremony regardless of
# scenario — the ceremony is the render data shown to the user BEFORE any outcome is
# known, so it cannot vary by an outcome that hasn't happened yet. WS-A Stream-Z
# ADDITIVELY folds in `schema_version`/`kind`/`device_code` (auth.schema.json's
# `deviceCode` shape) alongside the original four wizard-frozen fields — the Rust
# seam drops unknown fields, so this is safe for the existing wizard consumer:
#   {"schema_version":"1.0","kind":"device-code","user_code":"WDJB-MJHT","verification_uri":"https://example.com/device","expires_in":900,"interval":5,"device_code":"mock-device-code-0000"}
#
# The POLL call (--poll) emits a JSON object carrying `status` (WS-A Stream-Z
# ADDITIVELY folds in `schema_version`/`kind:"poll"` alongside it, same additive-safe
# rule as the ceremony above):
#   {"schema_version":"1.0","kind":"poll","status":"authorized"}   (or "denied" / "expired" / "timeout" / "pending")
#
# NEVER emits a real or realistic-looking token — the app must hold nothing (invariant
# #6; ADR-M3-001; fitness fn 2 no-secret-on-wizard-DTO). The one exception,
# `authorized-leaked-field-adversarial`, exists ONLY as a negative-test fixture: it adds
# an obviously-synthetic, obviously-fake extra field to an otherwise-`authorized` poll
# response, so the Rust seam's parser can be proven to drop/ignore any unexpected
# token-shaped field rather than forward it into the WizardState DTO. The fake value is
# clearly labeled (`FAKE-SYNTHETIC-NOT-A-REAL-TOKEN...`) and is never emitted by any
# other scenario.
#
# Exit code for `auth` (consistent with the existing contract's two non-doctor-specific
# codes — there is no per-body "severity" concept for auth, so only two codes apply):
#   0  normal — the JSON parses and describes a real ceremony/poll outcome, INCLUDING
#      the honest-failure outcomes (denied/expired/timeout/pending are normal, expected
#      terminal/interim states, not env errors)
#   2  env error — CT_AUTH_SCENARIO=exit-2, or an unrecognized scenario name
#
# `mock-cc auth status --json` (WS-A Stream-Z, offline-safe "who is signed in", no
# --poll/ceremony concept): driven by the SAME $CT_AUTH_SCENARIO/$CC_AUTH_SCENARIO/
# --scenario selection as above. "authorized" -> `{"schema_version":"1.0","kind":"status","status":"authorized","identity":{"login":"octocat"}}`;
# every other scenario name (including the default-unset case) -> `{"schema_version":"1.0","kind":"status","status":"signed-out"}`.
# `exit-2` still simulates the env-error path. Exit code: always 0 (status is never a
# terminal-failure concept the way poll is — signed-out is a normal, renderable state).
#
# --- layers [join] (WS-A Stream-Z, D7.1 proposed contract addition) -------------------
# Fixture selection for `layers` (list) — the SAME $CT_FIXTURE/$CC_FIXTURE/--fixture
# convention as `doctor`, resolved against layers/corpus/<name>.json, then tried as a
# literal path. Default (when unset): "available". CT_FIXTURE=list/exit-2 behave the
# same as `doctor`'s (list also enumerates the layers corpus).
#
# `mock-cc layers join <id> --json` reuses the SAME fixture-name selection to pick the
# join OUTCOME (never a corpus file of its own — the join_result body is small enough
# to synthesize inline, echoing the caller's own `<id>` positional argument):
#   available     -> {"result":"joined", synced_lock_sha included}
#   joined        -> {"result":"already-joined"}
#   not-entitled  -> {"result":"not-entitled"}
#   offline       -> {"result":"offline", reason included}
#   error         -> {"result":"error", reason:"unknown layer id"} (exit 1)
#   exit-2        -> env/credential error, no body (exit 2)
#
# Exit code for `layers`/`layers join` (per cli-contract.md D7.1): `layers` (list) is
# always exit 0 once a fixture body is found (same simpler convention as
# `deprovision`/`update`); `layers join` is 0 for joined/already-joined/not-entitled/
# offline, 1 for the `error` fixture, 2 for exit-2/unknown-fixture.
#
# --- freshness (WS-A Stream-Z) ---------------------------------------------------------
# `mock-cc freshness --json` (bare, the cheap single-SHA poll): a small canned body,
# not driven by any fixture corpus (there is exactly one shape to demonstrate).
#
# `mock-cc freshness --all-projects --json` (Component Sync per-project sweep): the
# SAME $CT_FIXTURE/$CC_FIXTURE/--fixture convention, resolved against
# projects/corpus/<name>.json (the `all_projects_freshness` shape). Default:
# "mixed-fresh-and-stale". Exit code: always 0 once a fixture body is found (read-only,
# no per-body severity concept), 2 for exit-2/unknown-fixture.
#
# `mock-cc update --project <path> --json` (Component Sync, one project): reuses the
# EXISTING update/corpus/<name>.json (update.schema.json shape) verbatim, with the
# caller's own `--project <path>` value stamped into the body's additive `path` field —
# the SAME $CT_FIXTURE/$CC_FIXTURE/--fixture convention and default ("applied-clean")
# as bare `update`.
#
# `mock-cc update --fanout --json` (Component Sync, the machine-wide roll-up): the SAME
# $CT_FIXTURE/$CC_FIXTURE/--fixture convention, resolved against
# projects/corpus/<name>.json (the `fanout_report` shape). Default: "12-of-14-updated".
# Exit code for both: same simpler convention as bare `update` (always 0 once a fixture
# body is found; 2 for exit-2/unknown-fixture).
#
# --- deprovision (M5/S2, `.copilot/wp/30.md`) ------------------------------------------
# Fixture selection for `deprovision <org>` — the SAME $CT_FIXTURE/$CC_FIXTURE/
# --fixture convention as `doctor` (checked in the same order), resolved against
# deprovision/corpus/<name>.json first, then deprovision/invalid/<name>.json, then
# tried as a literal path. Default (when unset): "wiped-clean". CT_FIXTURE=list and
# CT_FIXTURE=exit-2 behave the same as they do for `doctor` (list also enumerates the
# deprovision corpus; exit-2 simulates the env-error/flock-held path — no trustworthy
# body, exit 2).
#
# Exit code for `deprovision` — deliberately simpler than `doctor`'s: cli-contract.md's
# `deprovision` row names no per-body exit-code convention (no analogue of doctor's
# severity:"fail" -> exit 1), so this stub always exits 0 once a fixture body is found,
# EVERY fixture printed verbatim (including deprovision/invalid/ — those exist so the
# app's OWN fail-closed parsing, `model::deprovision::parse_deprovision_body`, is what's
# under test, exactly like doctor's `checker-missing-*` fixtures rely on the app failing
# closed on CONTENT rather than on the exit code):
#   0  a fixture body was found and printed (corpus/ OR invalid/ — see above)
#   2  CT_FIXTURE=exit-2, or the requested fixture can't be found
#
# NEVER wipes anything: this stub is pure text-in/text-out, exactly like `doctor` — it
# holds no filesystem-deletion logic at all, matching the real invariant this whole
# feature exists to prove (FF-M5-2, `tests/fitness_m5_no_wipe_logic.rs`).
#
# --- update (M6/S1, `.copilot/wp/37.md`, task 52) --------------------------------------
# Fixture selection for `update` — the SAME $CT_FIXTURE/$CC_FIXTURE/--fixture
# convention as `doctor`/`deprovision` (checked in the same order), resolved against
# update/corpus/<name>.json first, then update/invalid/<name>.json, then tried as a
# literal path. Default (when unset): "applied-clean". CT_FIXTURE=list and
# CT_FIXTURE=exit-2 behave the same as they do for `doctor`/`deprovision` (list also
# enumerates the update corpus; exit-2 simulates the env-error/flock-held path — no
# trustworthy body, exit 2).
#
# Exit code for `update` — same simpler convention as `deprovision`: cli-contract.md's
# `update` row names no per-body exit-code convention, so this stub always exits 0 once
# a fixture body is found, EVERY fixture printed verbatim (including update/invalid/ —
# those exist so the app's OWN fail-closed parsing, `model::update::parse_update_body`,
# is what's under test, never the exit code):
#   0  a fixture body was found and printed (corpus/ OR invalid/ — see above)
#   2  CT_FIXTURE=exit-2, or the requested fixture can't be found
#
# NEVER applies a real reconciling sync: this stub is pure text-in/text-out, exactly
# like `doctor`/`deprovision` — it holds no sync/merge/signature logic at all.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORPUS_DIR="$HERE/corpus"
INVALID_DIR="$HERE/invalid"
# M5/S2: the `deprovision` verb's own fixture corpus, deliberately separate
# from doctor's (a different --json shape entirely) — see
# fixtures/deprovision/README.md.
DEPROVISION_CORPUS_DIR="$HERE/deprovision/corpus"
DEPROVISION_INVALID_DIR="$HERE/deprovision/invalid"
# M6/S1: the `update` verb's own fixture corpus, deliberately separate from
# doctor/deprovision (a different --json shape entirely) — see
# fixtures/update/README.md.
UPDATE_CORPUS_DIR="$HERE/update/corpus"
UPDATE_INVALID_DIR="$HERE/update/invalid"
# WS-A Stream-Z: the `layers`/`layers join` verb's own fixture corpus
# (list_report shape, layers.schema.json) — see fixtures/layers/corpus/.
LAYERS_CORPUS_DIR="$HERE/layers/corpus"
# WS-A Stream-Z (Component Sync): the `freshness --all-projects`/
# `update --fanout` fixture corpus — one directory, two shapes
# (all_projects_freshness / fanout_report, projects.schema.json's `oneOf`),
# distinguished structurally exactly like the real schema — see
# fixtures/projects/corpus/.
PROJECTS_CORPUS_DIR="$HERE/projects/corpus"

# No hardcoded default here — `doctor` defaults to "healthy-clean-fleet" and
# `deprovision` defaults to "wiped-clean", applied below once $verb is known
# (both share the same $CT_FIXTURE/$CC_FIXTURE/--fixture selection
# convention; only the fallback-when-unset value differs per verb).
fixture="${CT_FIXTURE:-${CC_FIXTURE:-}}"
auth_scenario="${CT_AUTH_SCENARIO:-${CC_AUTH_SCENARIO:-authorized}}"

# --fixture=<name> / --fixture <name>, --scenario=<name> / --scenario <name>, and
# --poll on the command line win over env vars / defaults. WS-A Stream-Z additions:
# --project <path> / --fanout (for `update`), --all-projects (for `freshness`).
args=("$@")
verb=""
subverb=""
arg3=""
poll=0
project_path=""
fanout=0
all_projects=0
onboard_apply=0
ecosystem_onboard=0
i=0
while [ $i -lt ${#args[@]} ]; do
  arg="${args[$i]}"
  case "$arg" in
    --project=*)
      project_path="${arg#--project=}"
      ;;
    --project)
      i=$((i + 1))
      project_path="${args[$i]:-}"
      ;;
    --fanout)
      fanout=1
      ;;
    --all-projects)
      all_projects=1
      ;;
    --apply)
      onboard_apply=1
      ;;
    --org|--org=*)
      ecosystem_onboard=1
      if [ "$arg" = "--org" ]; then i=$((i + 1)); fi
      ;;
    --fixture=*)
      fixture="${arg#--fixture=}"
      ;;
    --fixture)
      i=$((i + 1))
      fixture="${args[$i]:-$fixture}"
      ;;
    --scenario=*)
      auth_scenario="${arg#--scenario=}"
      ;;
    --scenario)
      i=$((i + 1))
      auth_scenario="${args[$i]:-$auth_scenario}"
      ;;
    --poll)
      poll=1
      ;;
    --json) ;; # accepted, no-op marker
    -*) ;;      # ignore unknown flags
    *)
      if [ -z "$verb" ]; then
        verb="$arg"
      elif [ -z "$subverb" ]; then
        subverb="$arg"
      elif [ -z "$arg3" ]; then
        arg3="$arg"
      fi
      ;;
  esac
  i=$((i + 1))
done

# Per-verb default (only when nothing set $fixture at all — an explicit
# `--fixture=list`/`exit-2`/named fixture always wins, checked below).
if [ -z "$fixture" ]; then
  case "$verb" in
    deprovision) fixture="wiped-clean" ;;
    update)
      if [ "$fanout" -eq 1 ]; then
        fixture="12-of-14-updated"
      else
        fixture="applied-clean"
      fi
      ;;
    freshness) fixture="mixed-fresh-and-stale" ;;
    layers) fixture="available" ;;
    *) fixture="healthy-clean-fleet" ;;
  esac
fi

list_fixtures() {
  echo "corpus (valid, schema-passing, for 'doctor'):"
  for f in "$CORPUS_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "invalid (adversarial, intentionally NOT schema-valid — for CliUnreadable tests):"
  for f in "$INVALID_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "deprovision corpus (valid, for 'deprovision <org> --json'):"
  for f in "$DEPROVISION_CORPUS_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "deprovision invalid (adversarial, for the Unreadable path):"
  for f in "$DEPROVISION_INVALID_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "update corpus (valid, for 'update --json'):"
  for f in "$UPDATE_CORPUS_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "update invalid (adversarial, for the Unreadable path):"
  for f in "$UPDATE_INVALID_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "auth scenarios (for 'auth' / 'auth login'):"
  echo "  authorized denied expired timeout pending authorized-leaked-field-adversarial"
  echo "auth status scenarios (for 'auth status'):"
  echo "  authorized (-> status:authorized)   anything else (-> status:signed-out)"
  echo "layers corpus (valid, for 'layers --json' / 'layers join <id> --json'):"
  for f in "$LAYERS_CORPUS_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "projects corpus (valid, for 'freshness --all-projects --json' / 'update --fanout --json'):"
  for f in "$PROJECTS_CORPUS_DIR"/*.json; do
    [ -e "$f" ] || continue
    printf '  %s\n' "$(basename "${f%.json}")"
  done
  echo "special: list, exit-2"
}

if [ "$fixture" = "list" ]; then
  list_fixtures
  exit 0
fi

if [ -z "$verb" ]; then
  echo "mock-cc: usage: mock-cc doctor --json | mock-cc auth --json [--poll] | mock-cc deprovision <org> --json   (or CT_FIXTURE=list mock-cc doctor --json)" >&2
  exit 2
fi

case "$verb" in
  workspace)
    if [ "$subverb" = "approve-root" ] && [ "$onboard_apply" -eq 1 ]; then
      printf '%s\n' '{"schema_version":"1.0","mode":"apply","result":"applied","root":{"name":"Projects","state":"approved","detail":"Control Tower will look for projects only inside this folder."}}'
    elif [ "$subverb" = "configure" ] && [ "$onboard_apply" -eq 1 ]; then
printf '%s\n' '{"schema_version":"1.0","mode":"apply","result":"applied","workspaces":[{"path":"/tmp/example-project","name":"example-project","project_id":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","state":"ready","detail":"Copilot is ready for this project.","declared_components":["claude","codex"],"installed_components":["claude","codex"],"recommended_components":["claude","codex"],"personal_profile":{"state":"associated","project_id":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},"setup_policy":"not-offered","policy_detail":"Copilot is already set up here, so there is nothing to ask.","can_apply_now":true,"apply_blocked_detail":null,"undo":{"available":false,"detail":"There is nothing here to undo yet."}}],"summary":{"ready":1,"setup-available":0,"activation-required":0,"blocked":0,"total":1},"actions":[{"id":"activate-components","scope":"project","status":"applied","detail":"Add the selected Copilot setup without replacing existing project files."}]}'
    elif [ "$subverb" = "revert" ]; then
      # B3 (undo/decline-cost close-out): the REAL `cc workspace revert`
      # report is a narrower shape than every other workspace verb's — no
      # `summary`/`discovery`/`recently_set_up` (see claude-copilot's
      # `workspaces.py` `revert` command; `native/cli-dtos.swift`'s
      # `WorkspaceRevertReport` is the app's own dedicated decode target for
      # exactly this reason). `--apply` applies; without it, this is the plan.
      if [ "$onboard_apply" -eq 1 ]; then
printf '%s\n' '{"schema_version":"1.0","mode":"apply","result":"applied","workspaces":[{"path":"/tmp/example-project","name":"example-project","project_id":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","state":"setup-available","detail":"Copilot can be set up for this project.","declared_components":[],"installed_components":[],"recommended_components":["claude","codex"],"personal_profile":{"state":"local-only","project_id":null},"setup_policy":"excluded","policy_detail":"You asked me not to set this project up again.","can_apply_now":true,"apply_blocked_detail":null,"undo":{"available":false,"detail":"There is nothing here to undo yet."}}],"revert":{"removed":["claude","codex"],"kept":[],"detail":"Removed. Your own files were left alone, and I will not set this project up again unless you ask."}}'
      else
printf '%s\n' '{"schema_version":"1.0","mode":"plan","result":"action-required","workspaces":[{"path":"/tmp/example-project","name":"example-project","project_id":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","state":"ready","detail":"Copilot is ready for this project.","declared_components":["claude","codex"],"installed_components":["claude","codex"],"recommended_components":["claude","codex"],"personal_profile":{"state":"associated","project_id":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},"setup_policy":"not-offered","policy_detail":"Copilot is already set up here, so there is nothing to ask.","can_apply_now":true,"apply_blocked_detail":null,"undo":{"available":true,"detail":"Removes only what I added. Your own files are left alone."}}],"revert":{"removed":[],"kept":[],"detail":"Removes only what I added. Your own files are left alone."}}'
