    resolve_layers_fixture_path() {
      local name="$1"
      if [ -f "$LAYERS_CORPUS_DIR/$name.json" ]; then
        echo "$LAYERS_CORPUS_DIR/$name.json"
      elif [ -f "$name" ]; then
        echo "$name"
      else
        echo ""
      fi
    }

    path="$(resolve_layers_fixture_path "$fixture")"
    if [ -z "$path" ]; then
      echo "mock-cc: unknown layers fixture '$fixture'. Run 'CT_FIXTURE=list mock-cc doctor --json' to list available fixtures." >&2
      exit 2
    fi

    # Same simpler convention as `deprovision`/`update`: no per-body
    # severity concept for `layers` (list), always exit 0 once a fixture
    # body is found.
    cat "$path"
    exit 0
    ;;

  connections)
    # `mock-cc connections --json` (task 221 bridge stage C). Two special
    # fixture names BEFORE the ordinary corpus lookup:
    #   exit-2            — same generic simulated env/credential error every
    #                        other verb supports.
    #   verb-unavailable  — simulates an installed `cc` build that PREDATES
    #                        this verb entirely: exit 2, NOTHING on stdout, a
    #                        Click-style usage error on stderr. Verified live
    #                        against the bundled 0.3.2 app's real `cc 2.1.2`
    #                        helper (task 221 stage C) — that exact command
    #                        produces empty stdout, "Error: No such command
    #                        'connections'." on stderr, exit 2.
    if [ "$fixture" = "exit-2" ]; then
      echo "mock-cc: simulated env error (e.g. credential store unreachable) — no trustworthy body emitted" >&2
      exit 2
    fi
    if [ "$fixture" = "verb-unavailable" ]; then
      echo "Usage: cc [OPTIONS] COMMAND [ARGS]..." >&2
      echo "Try 'cc --help' for help." >&2
      echo "Error: No such command 'connections'." >&2
      exit 2
    fi

    resolve_connections_fixture_path() {
      local name="$1"
      if [ -f "$CONNECTIONS_CORPUS_DIR/$name.json" ]; then
        echo "$CONNECTIONS_CORPUS_DIR/$name.json"
      elif [ -f "$name" ]; then
        echo "$name"
      else
        echo ""
      fi
    }

    path="$(resolve_connections_fixture_path "$fixture")"
    if [ -z "$path" ]; then
      echo "mock-cc: unknown connections fixture '$fixture'. Run 'CT_FIXTURE=list mock-cc doctor --json' to list available fixtures." >&2
      exit 2
    fi

    # Same simpler convention as `layers`/`deprovision`/`update`: no
    # per-body severity concept here, always exit 0 once a fixture body is
    # found (`result` inside the body itself carries any degradation).
    cat "$path"
    exit 0
    ;;

  connect)
    # `mock-cc connect <service-id> [--check] --json` (task 222,
    # connect.schema.json). Derives its answer from the SAME connections
    # corpus body `connections` above serves, for the same reason the real
    # verb reuses `cc connections`' machinery: there must be exactly one
    # description of what a service requires and what is missing.
    #
    # The load-bearing behaviour this fixture exists to prove is not the
    # happy path — it is that a VALUE only ever arrives on stdin. This mock
    # compares every supplied value against its own argv and against its
    # environment, and fails LOUDLY if it finds one there, so a future change
    # that starts passing a credential as an argument or an env var breaks a
    # test instead of shipping.
    if [ "$fixture" = "exit-2" ]; then
      echo "mock-cc: simulated env error (e.g. keychain unavailable) — no trustworthy body emitted" >&2
      exit 2
    fi
    if [ "$fixture" = "verb-unavailable" ]; then
      echo "Usage: cc [OPTIONS] COMMAND [ARGS]..." >&2
      echo "Try 'cc --help' for help." >&2
      echo "Error: No such command 'connect'." >&2
      exit 2
    fi

    connect_corpus="${fixture:-ready-and-needs-connect}"
    connect_path="$CONNECTIONS_CORPUS_DIR/$connect_corpus.json"
    if [ ! -f "$connect_path" ]; then
      echo "mock-cc: unknown connections fixture '$connect_corpus' for 'connect'." >&2
      exit 2
    fi

    connect_stdin=""
    if [ "$connect_check" -eq 0 ]; then
      # Read stdin whole. An empty stdin is a real, testable case
      # (`invalid-input`), not an error here.
      connect_stdin="$(cat)"
    fi

    python3 - "$connect_path" "$subverb" "$connect_check" "$connect_stdin" "${args[@]}" <<'PY'
import json
import os
import sys

corpus_path, service_id, check_flag, stdin_raw = sys.argv[1:5]
argv_rest = sys.argv[5:]
check = check_flag == "1"

with open(corpus_path, encoding="utf-8") as handle:
    report = json.load(handle)

row = next((r for r in report.get("connections", []) if r.get("id") == service_id), None)

def emit(payload):
    print(json.dumps(payload))
    sys.exit(0)

if row is None:
    emit({
        "schema_version": "1.0",
        "result": "unknown-service",
        "detail": f"There is no connection called '{service_id}' in your organization's setup.",
        "mode": "check" if check else "connect",
        "service": None,
        "credentials": None,
    })

if check:
    emit({
        "schema_version": "1.0",
        "result": "ok",
        "detail": None,
        "mode": "check",
        "service": row,
        "credentials": None,
    })

required = [entry["name"] for entry in row.get("requires_secret", [])]
missing = list(row.get("missing", []))

try:
    supplied = json.loads(stdin_raw) if stdin_raw.strip() else None
    if not isinstance(supplied, dict) or not all(isinstance(v, str) for v in supplied.values()):
        raise ValueError
except (ValueError, TypeError):
    emit({
        "schema_version": "1.0",
        "result": "invalid-input",
        "detail": "Control Tower sent something this helper could not read. Nothing was saved.",
        "mode": "connect",
        "service": row,
        "credentials": [
            {"name": name, "outcome": "failed", "detail": "no value was provided for this credential."}
            for name in required
        ],
    })

# The whole point of the fixture: a value must never have travelled by any
# route other than stdin.
for name, value in supplied.items():
    if not value:
        continue
    if any(value == token or value in token for token in argv_rest):
        print(f"mock-cc: FATAL — the value for {name} appeared in argv. Values must only ever reach the CLI on stdin.", file=sys.stderr)
        sys.exit(2)
    if any(value == env_value for env_value in os.environ.values()):
        print(f"mock-cc: FATAL — the value for {name} appeared in the environment. Values must only ever reach the CLI on stdin.", file=sys.stderr)
        sys.exit(2)

credentials = []
stored = set()
for name in required:
    if name not in missing:
        credentials.append({"name": name, "outcome": "already-present", "detail": None})
        continue
    value = supplied.get(name)
    if value is None:
        credentials.append({"name": name, "outcome": "failed", "detail": "no value was provided for this credential."})
    elif value == "":
        credentials.append({"name": name, "outcome": "failed", "detail": "value must not be empty."})
    elif value == "MOCK-KEYCHAIN-REFUSES":
        credentials.append({"name": name, "outcome": "failed", "detail": "this Mac's keychain refused to save it."})
    else:
        credentials.append({"name": name, "outcome": "stored", "detail": None})
        stored.add(name)

fresh = dict(row)
fresh["missing"] = [name for name in missing if name not in stored]
fresh["secret_state"] = "ready" if not fresh["missing"] else "needs-connect"

emit({
    "schema_version": "1.0",
    "result": "ok",
    "detail": None,
    "mode": "connect",
    "service": fresh,
    "credentials": credentials,
})
PY
    exit 0
    ;;

  auth)
    # `mock-cc auth login --json ...` is accepted as an alias for `mock-cc auth --json
    # ...` (D-3-M3 recommendation #2: the wizard's host/GitHub sign-in step is one more
    # `cc auth` integration, never a `gh auth status` screen-scrape). `status`
    # (WS-A Stream-Z) is the other recognized subverb; anything else is ignored
    # (forward-compatible with a future `cc auth <integration> --json` naming a real
    # per-integration verb).

    if [ "$auth_scenario" = "exit-2" ]; then
      echo "mock-cc: simulated env error (e.g. credential store unreachable) — no ceremony/poll/status body emitted" >&2
      exit 2
    fi

    if [ "$subverb" = "status" ]; then
      # Offline-safe "who is signed in" -- no --poll/ceremony concept. Driven
      # by the SAME scenario selection as the ceremony/poll forms: only
      # "authorized" renders a signed-in identity, every other scenario name
      # (including the default-unset case) is an honest "signed-out".
      if [ "$auth_scenario" = "status-not-valid-json" ]; then
        printf '%s\n' '{"schema_version":"1.0","kind":"status","status":'
      elif [ "$auth_scenario" = "authorized" ]; then
        printf '%s\n' '{"schema_version":"1.0","kind":"status","status":"authorized","identity":{"login":"octocat"}}'
      else
        printf '%s\n' '{"schema_version":"1.0","kind":"status","status":"signed-out"}'
      fi
      exit 0
    fi

    if [ "$subverb" = "grant" ]; then
      if [ "$poll" -eq 0 ]; then
        printf '%s\n' '{"schema_version":"1.0","kind":"grant-device-code","permission":"write:public_key","user_code":"GRNT-KEY1","verification_uri":"https://example.com/device","expires_in":900,"interval":5,"device_code":"mock-grant-device-code-0000"}'
      else
        printf '%s\n' '{"schema_version":"1.0","kind":"grant-poll","status":"granted"}'
      fi
      exit 0
    fi

    case "$auth_scenario" in
      authorized|denied|expired|timeout|pending|authorized-leaked-field-adversarial) ;;
      org-required-then-authorized|org-required-then-not-found|org-required-then-no-company-app|org-required-then-network-unavailable) ;;
      *)
        echo "mock-cc: unknown auth scenario '$auth_scenario'. Valid: authorized, denied, expired, timeout, pending, authorized-leaked-field-adversarial, org-required-then-authorized, org-required-then-not-found, org-required-then-no-company-app, org-required-then-network-unavailable, exit-2." >&2
        exit 2
        ;;
    esac

    # The four `org-required-then-*` scenarios (org-question copy spec
    # §2.1.1/§6): every call with no `--org` fails org-required, regardless
    # of --poll — a genuinely fresh Mac hits this on the ceremony AND would
    # hit it again on a poll that (unrealistically) omitted --org, since the
    # real CLI re-resolves the organization's client id on every call
    # (Appendix E.3). A call that DOES carry `--org` resolves per scenario;
    # `org-required-then-authorized` reduces to the ordinary `authorized`
    # scenario from here on, so the ceremony/poll logic below never needs to
    # know the difference.
    case "$auth_scenario" in
      org-required-then-authorized|org-required-then-not-found|org-required-then-no-company-app|org-required-then-network-unavailable)
        if [ "$ecosystem_onboard" -eq 0 ]; then
          printf '%s\n' '{"schema_version":"1.0","error":{"code":"org-required","message":"Nobody'\''s told me which organization you'\''re with yet, so I can'\''t sign you in."}}'
          exit 2
        fi
        case "$auth_scenario" in
          org-required-then-not-found)
            printf '%s\n' '{"schema_version":"1.0","error":{"code":"org-not-found","message":"'"${org_value:-that name}"' doesn'\''t look like an organization on GitHub."}}'
            exit 2
            ;;
          org-required-then-no-company-app)
            printf '%s\n' '{"schema_version":"1.0","error":{"code":"no-company-app","message":"GitHub reports your organization'\''s sign-in app isn'\''t finished being set up yet."}}'
            exit 2
            ;;
          org-required-then-network-unavailable)
            printf '%s\n' '{"schema_version":"1.0","error":{"code":"network-unavailable","message":"I couldn'\''t reach the network to check your organization'\''s sign-in setup."}}'
            exit 2
            ;;
          org-required-then-authorized)
            auth_scenario="authorized"
            ;;
        esac
        ;;
    esac

    if [ "$poll" -eq 0 ]; then
      # INITIATE — the ceremony is identical regardless of scenario; the outcome
      # hasn't happened yet. Canned per the frozen SHAPE (no schema exists upstream
      # yet — D-3-M3 batches the real freeze to WS-A). Never a token. WS-A
      # Stream-Z additively folds in schema_version/kind/device_code (see the
      # header comment above) -- the wizard's own validator/Rust seam ignore
      # unknown fields, so this is safe for the existing consumer.
      printf '%s\n' '{"schema_version":"1.0","kind":"device-code","user_code":"WDJB-MJHT","verification_uri":"https://example.com/device","expires_in":900,"interval":5,"device_code":"mock-device-code-0000"}'
      exit 0
    fi

    # POLL — a single terminal-or-pending status object. Never a token, except the
    # one deliberately-obvious adversarial fixture below (negative-test only).
    case "$auth_scenario" in
      authorized-leaked-field-adversarial)
        # Deliberately poisoned NEGATIVE-TEST fixture: an authorized outcome plus an
        # extra, unexpected, obviously-synthetic token-shaped field. The real CLI
        # NEVER emits this; it exists solely so the Rust seam's parser (S3) can be
        # proven to drop/ignore unknown fields rather than forward them into the
        # WizardState DTO (fitness fn 2: no-secret-on-wizard-DTO). See
        # fixtures/wizard/README.md.
        printf '%s\n' '{"schema_version":"1.0","kind":"poll","status":"authorized","access_token":"FAKE-SYNTHETIC-NOT-A-REAL-TOKEN-0000000000"}'
        ;;
      *)
        printf '{"schema_version":"1.0","kind":"poll","status":"%s"}\n' "$auth_scenario"
        ;;
    esac
    exit 0
    ;;

  config)
    # `cc config set github_app.org <name>` (org-question copy spec §2.1.1,
    # `CliClient.configSetGithubAppOrg`) -- the one config verb the app calls,
    # ONLY after a device code has already come back for a real organization
    # name. Succeeds (exit 0, no stdout) by default: the real `cc config set`
    # has no `--json` output either (Appendix E.4's own open contract
    # question), so `configSetGithubAppOrg` reads only the exit code, never a
    # body. `CT_CONFIG_SET_FAILS=1` forces it to fail instead, for the copy
    # spec's own "the pointer could not be written to this Mac" -> H2 row.
    if [ "$subverb" = "set" ]; then
      if [ "${CT_CONFIG_SET_FAILS:-0}" = "1" ]; then
        echo "mock-cc: simulated config-set failure" >&2
        exit 1
      fi
      exit 0
    fi
    echo "mock-cc: unsupported config invocation (only 'config set' is implemented)" >&2
    exit 1
    ;;

  *)
    echo "mock-cc: verb '$verb' is not implemented — this stub only emits 'doctor --json', 'auth --json [--poll]' / 'auth status --json', 'layers --json' / 'layers join <id> --json', 'connections --json', 'connect <service-id> [--check] --json', 'freshness --json' / 'freshness --all-projects --json', 'deprovision <org> --json', 'update --json' / 'update --project <path> --json' / 'update --fanout --json', and 'config set <key> <value>'" >&2
    exit 2
    ;;
esac
