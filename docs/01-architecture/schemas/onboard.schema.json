{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ineedacopilot.com/schemas/onboard.schema.json",
  "title": "Copilot repository onboarding plan/apply report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "owner", "mode", "result", "repositories", "summary"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scope": { "enum": ["organization", "personal"] },
    "owner": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["plan", "apply"] },
    "result": { "enum": ["ready", "changes-required", "applied", "blocked"] },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "role", "unit", "owner", "name", "visibility", "state", "action", "detail"],
        "properties": {
          "component": { "enum": ["knowledge", "cli", "claude", "codex"] },
          "role": { "enum": ["org", "department", "personal"] },
          "unit": { "type": ["string", "null"] },
          "owner": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "visibility": { "enum": ["private", "public", null] },
          "state": { "enum": ["existing-private", "missing", "created", "conflict-public", "unknown"] },
          "action": { "enum": ["none", "create", "blocked"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing", "missing", "created", "blocked"],
      "properties": {
        "existing": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
