node_modules/
dist/
# Rust / Tauri
/target/
**/target/
Cargo.lock.bak

# Node
build/
.vite/
.turbo/

# Tauri build artifacts
# Auto-generated by build.rs's AppManifest (T8/F3) — "DO NOT EDIT" ACL
# permission files regenerated from the command list on every build.

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.swp
.obsidian/workspace.json

# Claude Copilot memory index (local cache, not the memory entries themselves)
.claude/memory/memory.db
.claude/memory/memory.db-*

# Claude Copilot hook runtime state (session-local, matches claude-copilot's
# own .gitignore convention — never shared/authored content)
.claude/hooks/state/*.json
.claude/hooks/state/*.lock
.claude/hooks/state/*.tmp.*
.claude/hooks/state/.freeze

# Task Copilot local state (tc init) — local SQLite task DB, not shared config
.copilot/

# session review artifacts (not source)
scratchpad/

# cse-bench collector output — regenerated on every `collect` run
# (stamped history + -latest.json pointer), not source.
tools/cse-bench/output/
__pycache__/
*.pyc
